{% set requestedVariant = variant|default(stateSealDefaults.variant) %}
{% set sealVariant = requestedVariant in stateSealVariants ? requestedVariant : stateSealDefaults.variant %}
{% set requestedFileType = fileType|default(stateSealDefaults.fileType) %}
{% set sealFileType = requestedFileType in stateSealFileTypes ? requestedFileType : stateSealDefaults.fileType %}
{% set sealClassName = className|default('') %}
{% set sealClass = sealClassName ? 'mds-state-seal ' ~ sealClassName : 'mds-state-seal' %}
{% set sealAlt = alt|default(stateSealDefaults.alt) %}

<img
  class="{{ sealClass|e }}"
  src="{{ stateSealAssetSrcs[sealVariant][sealFileType]|e }}"
  alt="{{ sealAlt|e }}"
/>
