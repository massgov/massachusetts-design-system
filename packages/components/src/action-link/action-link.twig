{#
  Action link data:
  - The design has no disabled state.
  - size controls both the label typography and icon box.
  - leftIcon and rightIcon are icon names from the assets package.
#}
{% set actionLinkColor = color in actionLinkOptions.color ? color : actionLinkDefaults.color %}
{% set actionLinkSize = size in actionLinkOptions.size ? size : actionLinkDefaults.size %}
{% set actionLinkIconWeight = iconWeight in actionLinkOptions.iconWeight ? iconWeight : actionLinkDefaults.iconWeight %}
{% set actionLinkLeftIcon = actionLinkDefaults.leftIcon %}
{% if leftIcon is defined %}
  {% set actionLinkLeftIcon = leftIcon in actionLinkOptions.icon ? leftIcon : '' %}
{% endif %}
{% set actionLinkRightIcon = actionLinkDefaults.rightIcon %}
{% if rightIcon is defined %}
  {% set actionLinkRightIcon = rightIcon in actionLinkOptions.icon ? rightIcon : '' %}
{% endif %}
{% set actionLinkIconSize = actionLinkIconSizes[actionLinkSize] %}
{% set actionLinkText = text|default(actionLinkDefaults.text) %}
{% set actionLinkHref = href|default(actionLinkDefaults.href) %}
{% set actionLinkHtmlAttributes = htmlAttributes|default({}) %}
{% set actionLinkClassName = actionLinkHtmlAttributes.class|default('') %}
{% set actionLinkClass = 'mds-action-link mds-action-link--color-' ~ (actionLinkColor|lower) ~ ' mds-action-link--size-' ~ (actionLinkSize|lower) ~ (actionLinkClassName ? ' ' ~ actionLinkClassName : '') %}
{% set actionLinkAttributeExclusions = ['class', 'href'] %}

<a
  class="{{ actionLinkClass|e }}"
  href="{{ actionLinkHref|e }}"
  {% include 'shared/html-attributes.twig' with {
  attributes: actionLinkHtmlAttributes,
  exclude: actionLinkAttributeExclusions
} %}>

  <span class="mds-action-link__label">
    {% if actionLinkLeftIcon %}
      <span class="mds-action-link__icon">
        {%
          include 'icon.twig' with {
            name: actionLinkLeftIcon,
            weight: actionLinkIconWeight,
            size: actionLinkIconSize
          }
        %}
      </span>
    {% endif %}

    <span class="mds-action-link__text">{{ actionLinkText|e|replace({"\n": '<br>'})|raw }}</span>

    {% if actionLinkRightIcon %}
      <span class="mds-action-link__icon">
        {%
          include 'icon.twig' with {
            name: actionLinkRightIcon,
            weight: actionLinkIconWeight,
            size: actionLinkIconSize
          }
        %}
      </span>
    {% endif %}
  </span>
</a>
