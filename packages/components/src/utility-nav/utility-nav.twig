{#
  Utility Nav data:
  - startVariant chooses the left-side control: menu, home-link, or none.
  - menuButton* controls the primary navigation trigger button.
  - homeLink* controls the optional Mass.gov link variant.
  - actionButtons renders up to two ghost buttons on the right side.
  - className appends optional custom classes to the component root.
#}
{% set utilityNavClassName = className|default(utilityNavDefaults.className) %}
{% set utilityNavStartVariant = startVariant|default(utilityNavDefaults.startVariant) %}
{% set menuButtonTextValue = menuButtonText|default(utilityNavDefaults.menuButtonText) %}
{% set menuButtonAriaLabelValue = menuButtonAriaLabel|default(utilityNavDefaults.menuButtonAriaLabel) %}
{% set menuButtonExpandedValue = menuButtonExpanded is same as(true) ? true : utilityNavDefaults.menuButtonExpanded %}
{% set menuButtonControlsValue = menuButtonControls|default(utilityNavDefaults.menuButtonControls) %}
{% set homeLinkTextValue = homeLinkText|default(utilityNavDefaults.homeLinkText) %}
{% set homeLinkHrefValue = homeLinkHref|default(utilityNavDefaults.homeLinkHref) %}
{% set homeLinkAriaLabelValue = homeLinkAriaLabel|default(utilityNavDefaults.homeLinkAriaLabel) %}
{% set utilityNavActionButtons = actionButtons is iterable ? actionButtons|slice(0, 2) : utilityNavDefaults.actionButtons %}
{% set utilityNavClasses = ['mds-utility-nav'] %}

{% if utilityNavClassName %}
  {% set utilityNavClasses = utilityNavClasses|merge([utilityNavClassName]) %}
{% endif %}

<div class="{{ utilityNavClasses|join(' ')|e }}">
  <div class="mds-utility-nav__section mds-utility-nav__section--start">
    {% if utilityNavStartVariant == 'menu' %}
      {% include 'button.twig' with {
        type: 'Ghost',
        color: 'White',
        size: 'Regular',
        text: menuButtonTextValue,
        leftIcon: 'list',
        leftIconWeight: 'Regular',
        className: 'mds-utility-nav__button mds-utility-nav__button--menu',
        ariaLabel: menuButtonAriaLabelValue,
        ariaExpanded: menuButtonExpandedValue,
        ariaControls: menuButtonControlsValue
      } %}
    {% elseif utilityNavStartVariant == 'home-link' %}
      {% include 'button.twig' with {
        type: 'Ghost',
        color: 'White',
        size: 'Regular',
        text: homeLinkTextValue,
        href: homeLinkHrefValue,
        leftIcon: 'house-line',
        leftIconWeight: 'Regular',
        className: 'mds-utility-nav__button mds-utility-nav__button--home',
        ariaLabel: homeLinkAriaLabelValue
      } %}
    {% endif %}
  </div>

  <div class="mds-utility-nav__section mds-utility-nav__section--end">
    {% for actionButton in utilityNavActionButtons %}
      {% set actionButtonText = actionButton.text|default('') %}
      {% set actionButtonHref = actionButton.href|default('') %}
      {% set actionButtonIconName = actionButton.iconName in iconOptions.name ? actionButton.iconName : '' %}
      {% set actionButtonIconWeight = actionButton.iconWeight in iconOptions.weight ? actionButton.iconWeight : iconDefaults.weight %}
      {% include 'button.twig' with {
        type: 'Ghost',
        color: 'White',
        size: 'Regular',
        text: actionButtonText,
        href: actionButtonHref,
        leftIcon: actionButtonIconName,
        leftIconWeight: actionButtonIconWeight,
        className: 'mds-utility-nav__button mds-utility-nav__button--action'
      } %}
    {% endfor %}
  </div>
</div>
