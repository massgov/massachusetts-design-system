{#
  Icon button data:
  - type and color map to the Figma Style and Color properties.
  - disabled prevents native button interaction.
  - htmlAttributes applies native HTML, ARIA, and data attributes to the root element.
#}
{% set iconButtonColor = color in iconButtonOptions.color ? color : iconButtonDefaults.color %}
{% set iconButtonType = type in iconButtonOptions.type ? type : iconButtonDefaults.type %}
{% set iconButtonIcon = icon in iconButtonOptions.icon ? icon : iconButtonDefaults.icon %}
{% set iconButtonHref = href|default(iconButtonDefaults.href) %}
{% set iconButtonAriaLabel = ariaLabel|default(iconButtonDefaults.ariaLabel) %}
{% set iconButtonDisabled = disabled|default(iconButtonDefaults.disabled) %}
{% set iconButtonUnavailable = iconButtonDisabled %}
{% set iconButtonHtmlAttributes = htmlAttributes|default({}) %}
{%
  set iconButtonAnchorAttributeExclusions = iconButtonDisabled
  ? ['class', 'disabled', 'href', 'type', 'aria-label', 'aria-disabled', 'tabindex']
  : ['class', 'disabled', 'href', 'type', 'aria-label']
%}
{%
  set iconButtonAttributeExclusions = [
    'class', 'disabled', 'href', 'type', 'aria-label'
  ]
%}
{% set iconButtonClassName = iconButtonHtmlAttributes.class|default('') %}
{% set iconButtonClass = 'mds-icon-button mds-icon-button--type-' ~ (iconButtonType|lower) ~ ' mds-icon-button--color-' ~ (iconButtonColor|lower) ~ (iconButtonClassName ? ' ' ~ iconButtonClassName : '') %}
{% if iconButtonDisabled %}
  {% set iconButtonClass = iconButtonClass ~ ' mds-icon-button--disabled' %}
{% endif %}

{% if iconButtonHref %}
  <a
    class="{{ iconButtonClass|e }}"
    {% if not iconButtonUnavailable %}
      href="{{ iconButtonHref|e }}"
    {% endif %}
    aria-label="{{ iconButtonAriaLabel|e }}"
    {% if iconButtonUnavailable %}
      aria-disabled="true"
      tabindex="-1"
    {% endif %}
    {%
      include 'shared/html-attributes.twig' with {
        attributes: iconButtonHtmlAttributes,
        exclude: iconButtonAnchorAttributeExclusions
      }
    %}
  >
{% else %}
  <button
    class="{{ iconButtonClass|e }}"
    type="{{ iconButtonHtmlAttributes.type|default('button')|e }}"
    aria-label="{{ iconButtonAriaLabel|e }}"
    {% if iconButtonUnavailable %}
      disabled
    {% endif %}
    {%
      include 'shared/html-attributes.twig' with {
        attributes: iconButtonHtmlAttributes,
        exclude: iconButtonAttributeExclusions
      }
    %}
  >
{% endif %}
<span class="mds-icon-button__icon">
  {%
    include 'icon.twig' with {
      name: iconButtonIcon,
      size: 'MD'
    }
  %}
</span>
{% if iconButtonHref %}
  </a>
{% else %}
  </button>
{% endif %}
