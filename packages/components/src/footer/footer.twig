{% set requestedTheme = theme|default('Neutral') %}
{% set footerTheme = requestedTheme in footerOptions.theme ? requestedTheme : 'Neutral' %}
{% set themeKey = footerTheme|lower %}
{% set footerClass = 'mds-footer' ~ (themeKey == 'primary' ? ' mds-footer--primary' : '') %}
{% set footerSiteNameId = siteNameId|default('') %}
{% set footerSiteName = siteName|default(footerDefaults.siteName) %}
{% set footerSealAlt = sealAlt|default('') %}
{% set footerSealColor = themeKey == 'primary' ? 'white' : 'black' %}
{% set footerIconButtonColor = themeKey == 'primary' ? 'White' : 'Primary' %}
{% set footerSocialLabel = socialLabel|default('') %}
{% set footerSocialLinks = socialLinks|default([]) %}
{% set footerDescriptionHtml = descriptionHtml|default('') %}
{% set footerContactHeadingId = contactHeadingId|default('') %}
{% set footerContactHeading = contactHeading|default('') %}
{% set footerContactItems = contactItems|default([]) %}
{% set footerLinkGroups = linkGroups|default([]) %}
{% set footerLegalLabel = legalLabel|default('') %}
{% set footerLegalLinks = legalLinks|default([]) %}
{% set footerLegalLinksOptional = legalLinksOptional|default([]) %}
{% set footerShowOptionalLegalLinks =
  showOptionalLegalLinks|default(footerDefaults.showOptionalLegalLinks)
%}
{% set footerFundingText = fundingText|default('') %}
{% set footerTrademarkHtml = trademarkHtml|default('') %}

<footer class="{{ footerClass|e }}">
  <div class="mds-footer__container">
    <div class="mds-footer__content">
      <section class="mds-footer__brand mds-footer__column"{% if footerSiteNameId %} aria-labelledby="{{ footerSiteNameId|e }}"{% endif %}>
        <div class="mds-footer__brand-heading">
          {% include 'state-seal.twig' with {
            alt: footerSealAlt,
            className: 'mds-footer__seal',
            color: footerSealColor,
            fileType: 'png'
          } %}
          <h2{% if footerSiteNameId %} id="{{ footerSiteNameId|e }}"{% endif %} class="mds-footer__site-name">{{ footerSiteName|e }}</h2>
        </div>

        {% if footerSocialLinks|length %}
          <ul class="mds-footer__social-list"{% if footerSocialLabel %} aria-label="{{ footerSocialLabel|e }}"{% endif %}>
            {% for socialLink in footerSocialLinks %}
              {% set socialIcon = socialLink.icon in footerOptions.icon ? socialLink.icon : '' %}
              {% if socialLink.href and socialLink.label and socialIcon %}
                <li>
                  {% include 'icon-button.twig' with {
                    element: 'a',
                    color: footerIconButtonColor,
                    href: socialLink.href,
                    icon: socialIcon,
                    iconWeight: 'Regular',
                    ariaLabel: socialLink.label
                  } %}
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        {% if footerDescriptionHtml %}
          <p class="mds-footer__description">{{ footerDescriptionHtml|raw }}</p>
        {% endif %}
      </section>

      {% if footerContactItems|length %}
        <section class="mds-footer__column"{% if footerContactHeadingId and footerContactHeading %} aria-labelledby="{{ footerContactHeadingId|e }}"{% endif %}>
          {% if footerContactHeading %}
            <h3 id="{{ footerContactHeadingId|e }}" class="mds-footer__heading">
              {{ footerContactHeading|e }}
            </h3>
          {% endif %}
          <address class="mds-footer__contact">
            {% for contactItem in footerContactItems %}
              {% set contactIcon = contactItem.icon in footerOptions.icon ? contactItem.icon : '' %}
              {% if contactItem.addressLines|length %}
                <div class="mds-footer__contact-item">
                  {% if contactIcon %}
                    <span class="mds-footer__contact-icon mds-footer__icon" aria-hidden="true">
                      {% include 'icon.twig' with {
                        name: contactIcon,
                        weight: 'Regular'
                      } %}
                    </span>
                  {% endif %}
                  <div>
                    <p class="mds-footer__contact-address">
                      {% for addressLine in contactItem.addressLines %}
                        {{ addressLine|e }}{% if not loop.last %}<br />{% endif %}
                      {% endfor %}
                    </p>
                    {% if contactItem.note %}
                      <p class="mds-footer__contact-note">
                        {{ contactItem.note|e }}
                      </p>
                    {% endif %}
                  </div>
                </div>
              {% elseif contactItem.text %}
                <p class="mds-footer__contact-item">
                  {% if contactIcon %}
                    <span class="mds-footer__icon--contact mds-footer__icon" aria-hidden="true">
                      {% include 'icon.twig' with {
                        name: contactIcon,
                        weight: 'Regular'
                      } %}
                    </span>
                  {% endif %}
                  {% if contactItem.href %}
                    <a class="mds-footer__contact-link mds-action-link" href="{{ contactItem.href|e }}">{{ contactItem.text|e }}</a>
                  {% else %}
                    {{ contactItem.text|e }}
                  {% endif %}
                </p>
              {% endif %}
            {% endfor %}
          </address>
        </section>
      {% endif %}

      {% for linkGroup in footerLinkGroups %}
        {% set linkGroupIndex = loop.index %}
        {% if linkGroup.heading or linkGroup.links|length %}
          {% set linkGroupHeadingId = linkGroup.headingId|default('mds-footer-links-heading-' ~ loop.index) %}
          <nav class="mds-footer__column" aria-labelledby="{{ linkGroupHeadingId|e }}">
            {% if linkGroup.heading %}
              <h3
                id="{{ linkGroupHeadingId|e }}"
                class="mds-footer__heading{% if linkGroup.eyebrow %} mds-letter-spacing-eyebrow{% endif %}"
              >
                {{ linkGroup.heading|e }}
              </h3>
            {% endif %}
            {% if linkGroup.links|length %}
              <ul class="mds-footer__link-list">
                {% for link in linkGroup.links %}
                  {% if link.href and link.text %}
                  {% set actionLinkData = {
                      href: link.href,
                      rightIcon: link.icon,
                      size: 'Medium',
                      text: link.text
                    } %}
                    {% if link.iconAccessibleText is defined and link.iconAccessibleText %}
                      {% set actionLinkData = actionLinkData|merge({
                        rightIconAccessibleText: link.iconAccessibleText,
                        rightIconAccessibleTextId: 'mds-footer-link-icon-accessible-text-' ~ linkGroupIndex ~ '-' ~ loop.index
                      }) %}
                    {% endif %}
                    <li>
                       {% include 'action-link.twig' with actionLinkData %}
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
            {% endif %}
          </nav>
        {% endif %}
      {% endfor %}
    </div>

    {% if footerLegalLinks|length %}
      <nav class="mds-footer__legal-nav"{% if footerLegalLabel %} aria-label="{{ footerLegalLabel|e }}"{% endif %}>
        <ul>
          {% for link in footerLegalLinks %}
            {% if link.href and link.text %}
              <li>
              {% include 'action-link.twig' with {
                href: link.href,
                size: 'Medium',
                text: link.text
              } %}
              </li>
            {% endif %}
          {% endfor %}
          {% if footerShowOptionalLegalLinks %}
            {% for link in footerLegalLinksOptional %}
              {% if link.href and link.text %}
                <li>
                {% include 'action-link.twig' with {
                  href: link.href,
                  size: 'Medium',
                  text: link.text
                } %}
                </li>
              {% endif %}
            {% endfor %}
          {% endif %}
        </ul>
      </nav>
    {% endif %}

    {% if footerFundingText or footerTrademarkHtml %}
      <div class="mds-footer__fine-print">
        {% if footerFundingText %}
          <p>{{ footerFundingText|e }}</p>
        {% endif %}
        {% if footerTrademarkHtml %}
          <p class="mds-footer__trademark">{{ footerTrademarkHtml|raw }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>
</footer>
