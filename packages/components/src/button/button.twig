<button class="mds-button mds-button--{{ variant|e }}{% if fullWidth %} mds-button--full-width{% endif %}" type="{{ type|e }}" data-mds-button{% if id %} id="{{ id|e }}"{% endif %}{% if disabled %} disabled{% endif %}{% if ariaLabel %} aria-label="{{ ariaLabel|e }}"{% endif %}>
  <span class="mds-button__label">{{ label|e }}</span>
</button>
