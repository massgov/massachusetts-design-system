{#
  Button data:
  - type, color, and size become CSS modifier classes.
  - htmlAttributes applies native HTML, ARIA, and data attributes to the root element.
  - href renders the component as an anchor with matching visual styles.
  - leftIcon and rightIcon are icon names from the assets package.
#}
{% set buttonType = type in buttonOptions.type ? type : buttonDefaults.type %}
{% set buttonColor = color in buttonOptions.color ? color : buttonDefaults.color %}
{% set buttonSize = size in buttonOptions.size ? size : buttonDefaults.size %}
{% set buttonText = text|default(buttonDefaults.text) %}
{% set leftIconName = leftIcon in buttonOptions.icon ? leftIcon : buttonDefaults.leftIcon %}
{% set rightIconName = rightIcon in buttonOptions.icon ? rightIcon : buttonDefaults.rightIcon %}
{% set leftIconWeightValue = leftIconWeight|default('Bold') %}
{% set leftIconWeight = leftIconWeightValue in ['Regular', 'Bold'] ? leftIconWeightValue : 'Bold' %}
{% set rightIconWeightValue = rightIconWeight|default('Bold') %}
{% set rightIconWeight = rightIconWeightValue in ['Regular', 'Bold'] ? rightIconWeightValue : 'Bold' %}
{% set buttonHtmlAttributes = htmlAttributes|default({}) %}
{% set buttonHref = href|default(buttonDefaults.href) %}
{% set buttonDisabled = disabled|default(buttonDefaults.disabled) %}
{% set buttonClassName = buttonHtmlAttributes.class|default('') %}
{% set buttonClass = 'mds-button mds-button--type-' ~ buttonType|lower ~ ' mds-button--color-' ~ buttonColor|lower ~ ' mds-button--size-' ~ buttonSize|lower ~ (buttonClassName ? ' ' ~ buttonClassName : '') %}

{% if buttonHref %}
<a
  class="{{ buttonClass|e }}"
  {% if not buttonDisabled %}href="{{ buttonHref|e }}"{% endif %}
  data-mds-button{% if buttonDisabled %}
  aria-disabled="true"
  tabindex="-1"{% endif %}{% for name, value in buttonHtmlAttributes %}{% if name not in ['class', 'data-mds-button', 'disabled', 'href', 'type'] and (not buttonDisabled or name not in ['aria-disabled', 'tabindex']) and value is not same as(false) and value is not null %}
  {{ name|e('html_attr') }}="{% if value is same as(true) %}true{% else %}{{ value|e('html_attr') }}{% endif %}"{% endif %}{% endfor %}
>
{% else %}
<button
  class="{{ buttonClass|e }}"
  type="{{ buttonHtmlAttributes.type|default('button')|e }}"
  data-mds-button{% if buttonDisabled %}
  disabled{% endif %}{% for name, value in buttonHtmlAttributes %}{% if name not in ['class', 'data-mds-button', 'disabled', 'href', 'type'] and value is not same as(false) and value is not null %}
  {{ name|e('html_attr') }}="{% if value is same as(true) %}true{% else %}{{ value|e('html_attr') }}{% endif %}"{% endif %}{% endfor %}
>
{% endif %}
  {% if leftIconName %}
    <span class="mds-button__icon mds-button__icon--left">
      {% include 'icon.twig' with {
        name: leftIconName,
        weight: leftIconWeight
      } %}
    </span>
  {% endif %}

  <span class="mds-button__label">{{ buttonText|e }}</span>

  {% if rightIconName %}
    <span class="mds-button__icon">
      {% include 'icon.twig' with {
        name: rightIconName,
        weight: rightIconWeight
      } %}
    </span>
  {% endif %}
{% if buttonHref %}
</a>
{% else %}
</button>
{% endif %}
