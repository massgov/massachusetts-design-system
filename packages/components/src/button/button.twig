<button class="mds-button mds-button--type-{{ type|lower|e }} mds-button--color-{{ color|lower|e }} mds-button--size-{{ size|lower|e }}{% if fullWidth %} mds-button--full-width{% endif %}" type="{{ htmlType|default('button')|e }}" data-mds-button{% if id %} id="{{ id|e }}"{% endif %}{% if disabled %} disabled{% endif %}{% if ariaLabel %} aria-label="{{ ariaLabel|e }}"{% endif %}>
{% if leftIcon == 'arrow-right' %}
  <span class="mds-button__icon mds-button__icon--left" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false" xmlns="http://www.w3.org/2000/svg">
      <path d="m21.28 12.53-6.75 6.75a.75.75 0 1 1-1.06-1.06l5.47-5.47H4.25a.75.75 0 0 1 0-1.5h14.69l-5.47-5.47a.75.75 0 1 1 1.06-1.06l6.75 6.75a.75.75 0 0 1 0 1.06" />
    </svg>
  </span>
{% endif %}
  <span class="mds-button__label">{{ text|e }}</span>
{% if rightIcon == 'arrow-right' %}
  <span class="mds-button__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false" xmlns="http://www.w3.org/2000/svg">
      <path d="m21.28 12.53-6.75 6.75a.75.75 0 1 1-1.06-1.06l5.47-5.47H4.25a.75.75 0 0 1 0-1.5h14.69l-5.47-5.47a.75.75 0 1 1 1.06-1.06l6.75 6.75a.75.75 0 0 1 0 1.06" />
    </svg>
  </span>
{% endif %}
</button>
