<button class="mds-button mds-button--type-{{ type|lower|e }} mds-button--color-{{ color|lower|e }} mds-button--size-{{ size|lower|e }}" type="{{ htmlType|default('button')|e }}" data-mds-button{% if id %} id="{{ id|e }}"{% endif %}{% if disabled %} disabled{% endif %}{% if ariaLabel %} aria-label="{{ ariaLabel|e }}"{% endif %}>
{% if leftIconMarkup %}{{ leftIconMarkup|raw }}{% endif %}
  <span class="mds-button__label">{{ text|e }}</span>
{% if rightIconMarkup %}{{ rightIconMarkup|raw }}{% endif %}
</button>
