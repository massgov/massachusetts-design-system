{
  "name": "@massds/mds-components",
  "version": "0.1.0-beta.0",
  "description": "Twig-authored static HTML and CSS components for the Massachusetts Design System",
  "type": "module",
  "files": [
    "dist/",
    "src/",
    "CHANGELOG.md"
  ],
  "exports": {
    "./index.css": "./dist/index.css",
    "./*.css": "./dist/*/*.css",
    "./*.html": "./dist/*/*.html",
    "./*.twig": "./dist/*/*.twig",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ./scripts/build.js",
    "changelog:release": "bash ../../scripts/compile-package-changelog.sh .",
    "lint": "npm run lint:scss && npm run lint:twig",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint:scss:fix": "npm run lint:scss -- --fix",
    "lint:twig": "npm run lint:twig:syntax && npm run lint:twig:format",
    "lint:twig:syntax": "node ./scripts/lint-twig.js",
    "lint:twig:format": "prettier --check \"src/**/*.twig\"",
    "lint:twig:fix": "prettier --write \"src/**/*.twig\"",
    "watch": "node --watch-path=src ./scripts/build.js",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@massds/mds-assets": "^1.2.0",
    "@massds/mds-tokens": "^3.0.0-beta.1"
  },
  "devDependencies": {
    "@destination/prettier-plugin-twig": "3.1.0",
    "@massds/mds-assets": "^1.2.0",
    "@massds/mds-styles": "^2.0.0-beta.1",
    "@massds/mds-tokens": "^3.0.0-beta.1",
    "prettier": "3.9.9",
    "sass": "^1.93.2",
    "stylelint": "^16.24.0",
    "stylelint-config-recommended-scss": "^16.0.2",
    "twig": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/massgov/massachusetts-design-system.git",
    "directory": "packages/components"
  },
  "keywords": [
    "components",
    "twig",
    "design-system",
    "massachusetts"
  ],
  "author": "Massachusetts Digital Services",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "24.14.0"
  },
  "volta": {
    "node": "24.14.0",
    "npm": "10.9.2"
  }
}
