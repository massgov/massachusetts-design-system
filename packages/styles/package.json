{
  "name": "@massds/mds-styles",
  "version": "1.1.0",
  "description": "Shared Sass and bundled CSS for the Massachusetts Design System",
  "style": "dist/css/index.css",
  "sass": "dist/scss/index.scss",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "sass": "./dist/scss/index.scss",
      "style": "./dist/css/index.css",
      "default": "./dist/css/index.css"
    },
    "./index.css": "./dist/css/index.css",
    "./index.min.css": "./dist/css/index.min.css",
    "./dist/*": "./dist/*",
    "./scss": "./dist/scss/index.scss",
    "./scss/mixins": "./dist/scss/mixins/index.scss",
    "./scss/mixins/index": "./dist/scss/mixins/index.scss",
    "./scss/mixins/*": "./dist/scss/mixins/_*.scss",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ./scripts/build.js",
    "changelog:release": "bash ../../scripts/compile-package-changelog.sh .",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "demo": "node ./scripts/open-styles-demo.js",
    "lint": "stylelint \"src/**/*.scss\" \"demo/**/*.css\"",
    "lint:fix": "stylelint --fix \"src/**/*.scss\" \"demo/**/*.css\"",
    "prepublishOnly": "node ./scripts/build.js",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "release": "git push origin --tags",
    "watch": "node ./scripts/watch.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/massgov/massachusetts-design-system.git",
    "directory": "packages/styles"
  },
  "keywords": [
    "css",
    "sass",
    "utilities",
    "design-system",
    "massachusetts"
  ],
  "author": "Massachusetts Digital Services",
  "license": "MIT",
  "peerDependencies": {
    "@massds/mds-tokens": "^2.0.0"
  },
  "devDependencies": {
    "sass": "^1.93.2",
    "stylelint": "^16.24.0",
    "stylelint-config-standard-scss": "^16.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "24.14.0"
  },
  "volta": {
    "node": "24.14.0",
    "npm": "10.9.2"
  }
}
