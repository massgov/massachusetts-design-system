{
  "name": "@massds/mds-assets",
  "version": "1.2.1",
  "description": "Asset library for the Massachusetts Design System",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node ./scripts/build.js",
    "inventory:figma-icons": "node ./src/icons/scripts/icon-name-inventory.js",
    "sync:figma-icons": "node ./src/icons/scripts/applyFigmaIconManifest.js",
    "prepublishOnly": "node ./scripts/build.js",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "changelog:release": "bash ../../scripts/compile-package-changelog.sh .",
    "release": "git push origin --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/massgov/massachusetts-design-system.git",
    "directory": "packages/assets"
  },
  "keywords": [
    "assets",
    "icons",
    "state-seal",
    "animation",
    "design-system"
  ],
  "author": "Massachusetts Digital Services",
  "license": "MIT",
  "devDependencies": {
    "svgo": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "24.14.0"
  },
  "volta": {
    "node": "24.14.0",
    "npm": "10.9.2"
  }
}
