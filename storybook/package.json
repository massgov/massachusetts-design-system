{
  "name": "@massds/storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Storybook documentation site for Massachusetts Design System packages",
  "type": "module",
  "scripts": {
    "dev": "npm run storybook",
    "storybook": "npm run build --workspace @massds/mds-components && storybook dev -p 6006 --host 127.0.0.1 --no-open --no-version-updates --disable-telemetry",
    "storybook:build": "npm run build --workspace @massds/mds-components && storybook build --disable-telemetry"
  },
  "dependencies": {
    "@massds/mds-assets": "^1.1.1",
    "@massds/mds-components": "^0.1.0",
    "@massds/mds-styles": "^1.1.0",
    "@massds/mds-tokens": "^2.0.0",
    "twig": "^3.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.3",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/html-vite": "^10.4.1",
    "path-browserify": "^1.0.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.4.1",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": "24.14.0"
  },
  "volta": {
    "node": "24.14.0",
    "npm": "10.9.2"
  }
}
